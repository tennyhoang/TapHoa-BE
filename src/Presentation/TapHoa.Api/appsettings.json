{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "BaseUrl": "http://localhost:5084",
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:3001",
      "https://zylova.vercel.app",
      "https://www.zylova.com"
    ]
  },
  "Cloudinary": {
    "CloudName": "REPLACE_OR_SET_ENV_Cloudinary__CloudName",
    "ApiKey":    "REPLACE_OR_SET_ENV_Cloudinary__ApiKey",
    "ApiSecret": "REPLACE_OR_SET_ENV_Cloudinary__ApiSecret"
  },
  "SePay": {
    "ApiKey": "REPLACE_OR_SET_ENV_SePay__ApiKey"
  },
  "Redis": {
    "ConnectionString": "localhost:6379"
  }
}
